{
  "name": "@local/dsh-trajecable",
  "version": "0.7.3",
  "description": "Race Control & Stage Log for local coding agents: 45° overhead Sector Cam, completion scores, decisions and AI comments",
  "private": true,
  "type": "module",
  "main": "dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test --test-force-exit test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
